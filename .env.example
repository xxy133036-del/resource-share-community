# docker compose 变量（复制为 .env 后填真实值；.env 已被 .gitignore 忽略）

# Java -> Python 服务间 RSA 密钥对（至少 2048 位）。
# Java 容器只挂载私钥，Python 容器只挂载公钥；不要提交密钥文件。
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out secrets/ai-agent-private.pem
# openssl pkey -in secrets/ai-agent-private.pem -pubout -out secrets/ai-agent-public.pem
AI_AGENT_SIGNING_PRIVATE_KEY_FILE=./secrets/ai-agent-private.pem
AI_AGENT_VERIFYING_PUBLIC_KEY_FILE=./secrets/ai-agent-public.pem

# JWT 的 RS256 密钥对。两个 Java 服务使用同一对密钥，Python 不需要该私钥。
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out secrets/jwt-private.pem
# openssl pkey -in secrets/jwt-private.pem -pubout -out secrets/jwt-public.pem
JWT_SIGNING_PRIVATE_KEY_FILE=./secrets/jwt-private.pem
JWT_VERIFYING_PUBLIC_KEY_FILE=./secrets/jwt-public.pem
